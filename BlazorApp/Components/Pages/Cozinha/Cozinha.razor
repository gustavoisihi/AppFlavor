@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@page "/cozinha"
@rendermode InteractiveServer
@using BlazorApp.Models.Dtos
@using BlazorApp.Models.Enums
@using BlazorApp.Services
@inject IPedidoService PedidoService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Cozinha</PageTitle>

<div class="kds-container">
    <header class="kds-header">
        <div>
            <h1>COZINHA</h1>
            <p>Painel de produção</p>
        </div>

        <div class="kds-header-info">
            <div class="kds-counter">
                <strong>@PedidosNovos.Count()</strong>
                <span>Novos</span>
            </div>

            <div class="kds-counter">
                <strong>@PedidosEmPreparo.Count()</strong>
                <span>Em preparo</span>
            </div>

            <div class="kds-counter">
                <strong>@PedidosProntos.Count()</strong>
                <span>Prontos</span>
            </div>

            <button class="kds-sound"
                    @onclick="AlternarSomAsync">
                @(somAtivo ? "🔊 Som ativado" : "🔇 Som desativado")
            </button>

            <button class="kds-refresh"
                    @onclick="CarregarPedidosAsync"
                    disabled="@carregando">
                ↻ Atualizar
            </button>
        </div>
    </header>

    @if (erro is not null)
    {
        <div class="alert alert-danger">@erro</div>
    }

    @if (carregando && pedidos.Count == 0)
    {
        <div class="kds-empty">Carregando pedidos...</div>
    }
    else
    {
        <div class="kds-columns">

            @* NOVOS *@
            <section class="kds-column">
                <div class="kds-column-header novo">
                    <span>NOVOS PEDIDOS</span>
                    <strong>@PedidosNovos.Count()</strong>
                </div>

                @if (!PedidosNovos.Any())
                {
                    <div class="kds-empty">Nenhum pedido novo</div>
                }

                @foreach (var pedido in PedidosNovos)
                {
                    <article class="kds-order-card novo" @key="pedido.Id">
                        <div class="kds-order-header">
                            <strong>#@pedido.Id</strong>
                            <span class="kds-timer @ClasseTempo(pedido.CriadoEm)">
                                @FormatarTempo(pedido.CriadoEm)
                            </span>
                        </div>

                        <div class="kds-customer">
                            @pedido.NomeCliente
                        </div>

                        @foreach (var item in pedido.Itens)
                        {
                            <div class="kds-item">
                                <strong>@item.Quantidade × @item.NomeProduto</strong>

                                @if (item.IngredientesRemovidos.Count > 0)
                                {
                                    <p class="kds-removed">
                                        Sem: @string.Join(", ", item.IngredientesRemovidos)
                                    </p>
                                }

                                @if (item.Adicionais.Count > 0)
                                {
                                    <p class="kds-additions">
                                        Adicionais: @string.Join(", ", item.Adicionais)
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Observacao))
                                {
                                    <p class="kds-observation">
                                        Obs.: @item.Observacao
                                    </p>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(pedido.Observacao))
                        {
                            <div class="kds-general-observation">
                                Pedido: @pedido.Observacao
                            </div>
                        }

                        <button class="kds-action novo"
                                disabled="@atualizando"
                                @onclick="() => AlterarStatusAsync(pedido.Id, StatusPreparo.EmPreparo)">
                            INICIAR PREPARO
                        </button>
                    </article>
                }
            </section>

            @* EM PREPARO *@
            <section class="kds-column">
                <div class="kds-column-header preparo">
                    <span>EM PREPARO</span>
                    <strong>@PedidosEmPreparo.Count()</strong>
                </div>

                @if (!PedidosEmPreparo.Any())
                {
                    <div class="kds-empty">Nenhum pedido em preparo</div>
                }

                @foreach (var pedido in PedidosEmPreparo)
                {
                    <article class="kds-order-card preparo" @key="pedido.Id">
                        <div class="kds-order-header">
                            <strong>#@pedido.Id</strong>
                            <span class="kds-timer @ClasseTempo(pedido.CriadoEm)">
                                @FormatarTempo(pedido.CriadoEm)
                            </span>
                        </div>

                        <div class="kds-customer">
                            @pedido.NomeCliente
                        </div>

                        @foreach (var item in pedido.Itens)
                        {
                            <div class="kds-item">
                                <strong>@item.Quantidade × @item.NomeProduto</strong>

                                @if (item.IngredientesRemovidos.Count > 0)
                                {
                                    <p class="kds-removed">
                                        Sem: @string.Join(", ", item.IngredientesRemovidos)
                                    </p>
                                }

                                @if (item.Adicionais.Count > 0)
                                {
                                    <p class="kds-additions">
                                        Adicionais: @string.Join(", ", item.Adicionais)
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Observacao))
                                {
                                    <p class="kds-observation">
                                        Obs.: @item.Observacao
                                    </p>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(pedido.Observacao))
                        {
                            <div class="kds-general-observation">
                                Pedido: @pedido.Observacao
                            </div>
                        }

                        <button class="kds-action preparo"
                                disabled="@atualizando"
                                @onclick="() => AlterarStatusAsync(pedido.Id, StatusPreparo.Pronto)">
                            MARCAR COMO PRONTO
                        </button>
                    </article>
                }
            </section>

            @* PRONTOS *@
            <section class="kds-column">
                <div class="kds-column-header pronto">
                    <span>PRONTOS</span>
                    <strong>@PedidosProntos.Count()</strong>
                </div>

                @if (!PedidosProntos.Any())
                {
                    <div class="kds-empty">Nenhum pedido pronto</div>
                }

                @foreach (var pedido in PedidosProntos)
                {
                    <article class="kds-order-card pronto" @key="pedido.Id">
                        <div class="kds-order-header">
                            <strong>#@pedido.Id</strong>
                            <span class="kds-timer @ClasseTempo(pedido.CriadoEm)">
                                @FormatarTempo(pedido.CriadoEm)
                            </span>
                        </div>

                        <div class="kds-customer">
                            @pedido.NomeCliente
                        </div>

                        @foreach (var item in pedido.Itens)
                        {
                            <div class="kds-item">
                                <strong>@item.Quantidade × @item.NomeProduto</strong>

                                @if (item.IngredientesRemovidos.Count > 0)
                                {
                                    <p class="kds-removed">
                                        Sem: @string.Join(", ", item.IngredientesRemovidos)
                                    </p>
                                }

                                @if (item.Adicionais.Count > 0)
                                {
                                    <p class="kds-additions">
                                        Adicionais: @string.Join(", ", item.Adicionais)
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Observacao))
                                {
                                    <p class="kds-observation">
                                        Obs.: @item.Observacao
                                    </p>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(pedido.Observacao))
                        {
                            <div class="kds-general-observation">
                                Pedido: @pedido.Observacao
                            </div>
                        }

                        <button class="kds-action pronto"
                                disabled="@atualizando"
                                @onclick="() => AlterarStatusAsync(pedido.Id, StatusPreparo.Entregue)">
                            MARCAR COMO ENTREGUE
                        </button>
                    </article>
                }
            </section>

        </div>
    }
</div>

@code {
    private List<PedidoCozinhaDto> pedidos = new();
    private bool carregando = true;
    private bool atualizando;
    private string? erro;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cancelamento;

    private IEnumerable<PedidoCozinhaDto> PedidosNovos => pedidos.Where(p => p.StatusPreparo == nameof(StatusPreparo.Novo));
    private IEnumerable<PedidoCozinhaDto> PedidosEmPreparo => pedidos.Where(p => p.StatusPreparo == nameof(StatusPreparo.EmPreparo));
    private IEnumerable<PedidoCozinhaDto> PedidosProntos => pedidos.Where(p => p.StatusPreparo == nameof(StatusPreparo.Pronto));
    private PeriodicTimer? timerRelogio;

    private bool somAtivo;
    private bool primeiraCarga = true;
    private HashSet<long> idsPedidosAnteriores = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarPedidosAsync();

        cancelamento = new CancellationTokenSource();

        // Atualiza os pedidos a cada 10 segundos
        timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = AtualizarPeriodicamenteAsync(cancelamento.Token);

        // Atualiza o cronômetro a cada segundo
        timerRelogio = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = AtualizarRelogioAsync(cancelamento.Token);
    }

    private async Task CarregarPedidosAsync()
    {
        carregando = true;
        erro = null;

        try
        {
            var pedidosAtualizados =
                await PedidoService.ListarPedidosCozinhaAsync();

            var idsAtuais = pedidosAtualizados
                .Select(p => p.Id)
                .ToHashSet();

            bool existemNovosPedidos =
                !primeiraCarga &&
                idsAtuais.Except(idsPedidosAnteriores).Any();

            pedidos = pedidosAtualizados;
            idsPedidosAnteriores = idsAtuais;

            primeiraCarga = false;

            if (existemNovosPedidos && somAtivo)
            {
                try
                {
                    await JS.InvokeVoidAsync("kdsAudio.tocar");
                }
                catch (Microsoft.JSInterop.JSException)
                {
                    // Evita que uma falha no áudio interrompa a atualização.
                }
            }
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os pedidos.";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task AlterarStatusAsync(
        long pedidoId,
        StatusPreparo novoStatus)
    {
        if (atualizando)
            return;

        atualizando = true;
        erro = null;

        try
        {
            await PedidoService.AtualizarStatusPreparoAsync(
                pedidoId, novoStatus);

            await CarregarPedidosAsync();
        }
        catch (InvalidOperationException ex)
        {
            erro = ex.Message;
        }
        catch (Exception)
        {
            erro = "Não foi possível atualizar o status do pedido.";
        }
        finally
        {
            atualizando = false;
        }
    }

    private async Task AtualizarPeriodicamenteAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            while (timer is not null &&
                   await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(CarregarPedidosAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // A página foi encerrada.
        }
        catch (ObjectDisposedException)
        {
            // O temporizador foi descartado.
        }
    }

    public void Dispose()
    {
        cancelamento?.Cancel();

        timer?.Dispose();
        timerRelogio?.Dispose();

        cancelamento?.Dispose();
    }

    private async Task AtualizarRelogioAsync(
    CancellationToken cancellationToken)
    {
        try
        {
            while (timerRelogio is not null &&
                   await timerRelogio.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // A página foi encerrada.
        }
        catch (ObjectDisposedException)
        {
            // O temporizador foi descartado.
        }
    }

    private TimeSpan ObterTempoDecorrido(DateTime criadoEm)
    {
        var tempo = DateTime.Now - criadoEm.ToLocalTime();

        return tempo < TimeSpan.Zero ? TimeSpan.Zero : tempo;
    }

    private string FormatarTempo(DateTime criadoEm)
    {
        var tempo = ObterTempoDecorrido(criadoEm);

        return $"{(int)tempo.TotalHours:00}:{tempo.Minutes:00}:{tempo.Seconds:00}";
    }

    private string ClasseTempo(DateTime criadoEm)
    {
        var tempo = ObterTempoDecorrido(criadoEm);

        if (tempo.TotalMinutes >= 10)
            return "atrasado";

        if (tempo.TotalMinutes >= 5)
            return "atencao";

        return "normal";
    }

    private async Task AlternarSomAsync()
    {
        if (somAtivo)
        {
            somAtivo = false;
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("kdsAudio.ativar");
            somAtivo = true;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            erro = "Não foi possível ativar o áudio.";
        }
    }
}
