@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@page "/ingredientes"
@using BlazorApp.Models.Entities
@using BlazorApp.Services

@inject IIngredientesService IngredientesService
@rendermode InteractiveServer

<PageTitle>Ingredientes</PageTitle>

<h3>Ingredientes</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NovoIngrediente">
        Novo ingrediente
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-danger">@erro</div>
}

@if (editando)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                @(ingrediente.Id == 0 ? "Novo ingrediente" : "Editar ingrediente")
            </h5>

            <EditForm Model="ingrediente" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <InputText class="form-control" @bind-Value="ingrediente.Nome" />
                </div>

                <div class="form-check mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="ingrediente.Ativo" />
                    <label class="form-check-label">
                        Ingrediente ativo
                    </label>
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="ingrediente.Disponivel" />
                    <label class="form-check-label">
                        Disponível para uso
                    </label>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@salvando">
                    @(salvando ? "Salvando..." : "Salvar")
                </button>

                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelarEdicao" disabled="@salvando">
                    Cancelar
                </button>
            </EditForm>
        </div>
    </div>
}

@if (carregando)
{
    <p>Carregando ingredientes...</p>
}
else if (ingredientes.Count == 0)
{
    <div class="alert alert-info">
        Nenhum ingrediente cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Status</th>
                    <th>Disponibilidade</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ingredientes)
                {
                    <tr @key="item.Id">
                        <td>@item.Nome</td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td>
                            @if (item.Disponivel)
                            {
                                <span class="badge bg-success">Disponível</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Indisponível
                                </span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(item)">
                                Editar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Ingrediente> ingredientes = new();
    private Ingrediente ingrediente = new();

    private bool carregando = true;
    private bool editando;
    private bool salvando;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        carregando = true;
        erro = null;

        try
        {
            ingredientes = await IngredientesService.ListarTodosAsync();
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os ingredientes.";
        }
        finally
        {
            carregando = false;
        }
    }

    private void NovoIngrediente()
    {
        ingrediente = new Ingrediente();
        editando = true;
        erro = null;
    }

    private void Editar(Ingrediente item)
    {
        ingrediente = new Ingrediente
        {
            Id = item.Id,
            Nome = item.Nome,
            Ativo = item.Ativo,
            Disponivel = item.Disponivel
        };

        editando = true;
        erro = null;
    }

    private void CancelarEdicao()
    {
        editando = false;
        ingrediente = new Ingrediente();
        erro = null;
    }

    private async Task SalvarAsync()
    {
        erro = null;
        ingrediente.Nome = ingrediente.Nome.Trim();

        if (string.IsNullOrWhiteSpace(ingrediente.Nome))
        {
            erro = "Informe o nome do ingrediente.";
            return;
        }

        salvando = true;

        try
        {
            if (ingrediente.Id == 0)
            {
                await IngredientesService.CriarAsync(ingrediente);
            }
            else
            {
                await IngredientesService.AtualizarAsync(ingrediente);
            }

            editando = false;
            ingrediente = new Ingrediente();

            await CarregarAsync();
        }
        catch (Exception)
        {
            erro = "Não foi possível salvar o ingrediente.";
        }
        finally
        {
            salvando = false;
        }
    }
}
