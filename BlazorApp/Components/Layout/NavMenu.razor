@implements IDisposable

@inject NavigationManager NavigationManager


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Sistema de Vendas</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3 mt-2">
            <span class="nav-link text-uppercase fw-bold">
                Operação
            </span>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/">
                <span class="bi bi-clipboard-check-fill me-2"
                      aria-hidden="true"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cozinha">
                <span class="bi bi-clipboard-check-fill me-2"
                      aria-hidden="true"></span>
                Cozinha
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-3">
            <span class="nav-link text-uppercase fw-bold">
                Cadastros
            </span>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="produtos">
                <span class="bi bi-basket-fill me-2"
                      aria-hidden="true"></span>
                Produtos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="categorias">
                <span class="bi bi-tags-fill me-2"
                      aria-hidden="true"></span>
                Categorias
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ingredientes">
                <span class="bi bi-list-check me-2"
                      aria-hidden="true"></span>
                Ingredientes
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="adicionais">
                <span class="bi bi-plus-circle-fill me-2"
                      aria-hidden="true"></span>
                Adicionais
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-3">
            <span class="nav-link text-uppercase fw-bold">
                Cliente
            </span>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cardapio">
                <span class="bi bi-journal-text me-2"
                      aria-hidden="true"></span>
                Cardápio
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}